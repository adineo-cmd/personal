---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageNavigation from '../components/PageNavigation.astro';
import { books } from '../data/content.js';
import { media } from '../data/library/media.js';

const statusStyles = {
  watching: { label: 'watching', color: '#8ec07c' },
  reading: { label: 'reading', color: '#fe8019' },
  watched: { label: 'watched', color: '#b8bb26' },
  finished: { label: 'finished', color: '#b8bb26' },
  planned: { label: 'planned', color: '#83a598' },
  want: { label: 'planned', color: '#83a598' },
  passed: { label: 'passed', color: '#928374' },
};

const normalize = (s) => (s === 'watching' || s === 'reading' ? 'watching' : s === 'watched' || s === 'finished' ? 'watched' : 'planned');

const anime = media.anime ?? [];
const movies = media.movies ?? [];
const series = media.series ?? [];
const manga = media.manga ?? [];
const games = media.games ?? [];
const passed = media.passed ?? [];

const bookEntries = [
  ...books.map((b) => ({
    title: b.title,
    author: b.author,
    status: b.status,
    pages: media.existingBookCovers?.[b.title]?.pages ?? null,
    year: media.existingBookCovers?.[b.title]?.year ?? null,
    cover: media.existingBookCovers?.[b.title]?.cover ?? null,
  })),
  ...(media.historyBooks ?? []),
];

const sections = [
  { id: 'anime', label: 'anime', accent: '#8ec07c', items: anime, kind: 'anime' },
  { id: 'movies', label: 'movies', accent: '#fe8019', items: movies, kind: 'movies' },
  { id: 'series', label: 'series', accent: '#d3869b', items: series, kind: 'series' },
  { id: 'manga', label: 'manga & manhua', accent: '#b8bb26', items: manga, kind: 'manga' },
  { id: 'games', label: 'games played', accent: '#83a598', items: games, kind: 'games' },
  { id: 'books', label: 'books', accent: '#8ec07c', items: bookEntries, kind: 'books' },
].filter((s) => s.items.length > 0);

const totalCounts = sections.map((s) => ({ label: s.label, accent: s.accent, count: s.items.length }));
const totalItems = totalCounts.reduce((sum, s) => sum + s.count, 0);

const fmtMins = (mins) => {
  if (!mins && mins !== 0) return null;
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  return h > 0 ? `${h}h ${m ? m + 'm' : ''}`.trim() : `${m}m`;
};

const animeMeta = (item) => {
  const parts = [];
  if (item.year) parts.push(item.year);
  if (item.format === 'MOVIE' && item.runtime) parts.push(fmtMins(item.runtime));
  else if (item.episodes) parts.push(`${item.episodes} eps`);
  if (item.total && item.format !== 'MOVIE') parts.push(`≈ ${item.total}`);
  return parts.join(' · ');
};

const movieMeta = (item) => [item.year, item.runtime ? fmtMins(item.runtime) : null].filter(Boolean).join(' · ');
const seriesMeta = (item) => [item.year, item.runtime ? `${item.runtime}m ep` : null].filter(Boolean).join(' · ');
const mangaMeta = (item) =>
  item.chapter
    ? `reading · ch. ${item.chapter}${item.totalChapters ? ` / ${item.totalChapters}` : ''}`
    : item.totalChapters
      ? `${item.totalChapters} ch`
      : (item.year ?? '');
const bookMeta = (item) => [item.author, item.pages ? `${item.pages}p` : null, item.year].filter(Boolean).join(' · ');
---

<BaseLayout title="Library | Aditya Yadav" description="The whole library — anime, movies, series, manga, manhua, games and books: watched, reading and planned.">
  <>
    <PageNavigation currentPage="library" />

    <div class="min-h-screen bg-[#1d2021] text-[#ebdbb2]">
      <div class="max-w-6xl mx-auto px-4 py-12">
        <header class="mb-8">
          <h1 class="text-5xl md:text-6xl font-serif mb-2">
            <span class="text-[#fbf1c7]">Lib</span><span class="text-[#8ec07c] italic">rary</span>
          </h1>
          <p class="text-[#a89984] text-sm md:text-base max-w-2xl">
            The whole shelf — anime, movies, series, manga, manhua, games and books. Watched, in progress and planned.
          </p>
          <p class="font-mono text-[11px] text-[#928374] mt-3">
            <span class="text-[#8ec07c]">{totalItems}</span> titles across
            {totalCounts.map((s, i) => (
              <span>
                {i > 0 && <span class="text-[#504945]"> · </span>}
                <span style={`color: ${s.accent}`}>{s.count}</span> {s.label}
              </span>
            ))}
          </p>

          <div class="flex flex-col sm:flex-row gap-3 mt-5">
            <div class="relative flex-1 max-w-md">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#928374] pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                id="library-search"
                type="text"
                placeholder="search the shelf..."
                aria-label="Search library"
                class="w-full bg-[#282828] border border-[#3c3836] text-[#ebdbb2] text-sm pl-9 pr-3 py-2 focus:outline-none focus:border-[#8ec07c]/50 placeholder-[#928374] font-mono"
              />
            </div>
            <div class="filter-bar flex flex-wrap gap-2" role="group" aria-label="Filter by status">
              <button type="button" class="filter-chip is-active" data-filter="all">all</button>
              <button type="button" class="filter-chip" data-filter="watching">in progress</button>
              <button type="button" class="filter-chip" data-filter="watched">done</button>
              <button type="button" class="filter-chip" data-filter="planned">planned</button>
            </div>
          </div>
        </header>

        <div class="flex flex-col gap-12" id="library-body">
          {sections.map((section) => (
            <section id={section.id} class="library-section scroll-mt-24" data-section={section.id} style={`--accent: ${section.accent}`}>
              <div class="flex items-baseline justify-between gap-4 mb-5 pb-3 border-b border-[#3c3836]">
                <h2 class="text-xl md:text-2xl font-serif tracking-tight" style={`color: ${section.accent}`}>
                  <span class="font-mono text-[10px] text-[#928374] mr-2">/</span>{section.label}
                </h2>
                <span class="font-mono text-[11px] text-[#928374]">{section.items.length}</span>
              </div>

              {section.kind === 'games' ? (
                <div class="grid sm:grid-cols-2 gap-3">
                  {section.items.map((item) => (
                    <div class="game-card media-card" data-status={normalize(item.status)} data-search={item.title.toLowerCase()}>
                      <div class="relative overflow-hidden border border-[#3c3836] bg-[#282828]/60 group hover:border-[var(--accent)] transition-colors">
                        <img src={item.cover} alt={item.title} loading="lazy" class="w-full aspect-video object-cover opacity-90 group-hover:opacity-100 transition-opacity" />
                        <span class="absolute top-2 right-2 status-chip" style={`background: color-mix(in srgb, ${statusStyles[item.status]?.color ?? '#928374'} 85%, transparent); color: #1d2021`}>{statusStyles[item.status]?.label ?? item.status}</span>
                      </div>
                      <div class="px-1 pt-2.5 pb-1">
                        <span class="text-[14px] font-medium text-[#ebdbb2]">{item.title}</span>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="poster-grid">
                  {section.items.map((item) => (
                    <div class="poster-card media-card" data-status={normalize(item.status)} data-search={(item.title + ' ' + (item.author ?? '')).toLowerCase()}>
                      <div class="relative overflow-hidden border border-[#3c3836] bg-[#282828] group hover:border-[var(--accent)] transition-colors">
                        {item.cover ? (
                          <img src={item.cover} alt={item.title} loading="lazy" class="w-full aspect-[2/3] object-cover opacity-90 group-hover:opacity-100 transition-opacity" />
                        ) : (
                          <div class="w-full aspect-[2/3] flex items-center justify-center p-3 text-center bg-[#282828]">
                            <span class="text-[11px] text-[#665c54] italic leading-snug">{item.title}</span>
                          </div>
                        )}
                        <span class="absolute top-2 left-2 status-chip" style={`background: color-mix(in srgb, ${statusStyles[item.status]?.color ?? '#928374'} 85%, transparent); color: #1d2021`}>{statusStyles[item.status]?.label ?? item.status}</span>
                      </div>
                      <div class="px-1 pt-2 pb-1">
                        <span class="block text-[13px] font-medium text-[#ebdbb2] leading-snug">
                          {section.kind === 'manga' && item.origin !== 'manga' && <span class="origin-chip">{item.origin}</span>}{item.title}
                        </span>
                        <span class="block font-mono text-[10px] text-[#928374] mt-0.5 leading-relaxed">
                          {section.kind === 'anime' && animeMeta(item)}
                          {section.kind === 'movies' && movieMeta(item)}
                          {section.kind === 'series' && seriesMeta(item)}
                          {section.kind === 'manga' && mangaMeta(item)}
                          {section.kind === 'books' && bookMeta(item)}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </section>
          ))}

          {passed.length > 0 && (
            <section id="passed" class="scroll-mt-24" data-section="passed">
              <div class="flex items-baseline justify-between gap-4 mb-4 pb-3 border-b border-[#3c3836]">
                <h2 class="text-xl md:text-2xl font-serif tracking-tight text-[#928374]">
                  <span class="font-mono text-[10px] text-[#504945] mr-2">/</span>passed on
                </h2>
                <span class="font-mono text-[11px] text-[#504945]">looked, moved on</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {passed.map((p) => (
                  <span class="inline-flex items-center gap-2 border border-[#3c3836] bg-[#282828]/40 px-3 py-1.5 text-[12px] text-[#a89984]" title={p.note}>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#504945]"></span>
                    {p.label}
                  </span>
                ))}
              </div>
            </section>
          )}
        </div>

        <div id="no-results" class="hidden text-center py-16 text-[#928374] italic text-sm">nothing on the shelf matches that.</div>

        <div class="mt-14 pt-6 border-t border-[#3c3836] flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-[#928374] font-mono">
          <span>~/library — anime · movies · series · manga · games played · books</span>
          <a href="/explore" class="hover:text-[#8ec07c] transition-colors underline decoration-[#504945] underline-offset-4">
            back to explore →
          </a>
        </div>
      </div>
    </div>
  </>
</BaseLayout>

<style>
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
    gap: 12px;
  }
  @media (min-width: 640px) {
    .poster-grid {
      grid-template-columns: repeat(auto-fill, minmax(136px, 1fr));
      gap: 16px;
    }
  }
  .media-card.is-hidden,
  .library-section.is-hidden,
  section[data-section="passed"].is-hidden {
    display: none;
  }
  .status-chip {
    font-family: 'Courier New', Courier, monospace;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    font-weight: 700;
  }
  .origin-chip {
    display: inline-block;
    font-family: 'Courier New', Courier, monospace;
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    padding: 0 4px;
    margin-right: 5px;
    border-radius: 2px;
    vertical-align: 1px;
  }
  .filter-chip {
    font-family: 'Courier New', Courier, monospace;
    font-size: 12px;
    padding: 4px 12px;
    border: 1px solid #3c3836;
    background: transparent;
    color: #928374;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-chip:hover {
    color: #ebdbb2;
    border-color: #504945;
  }
  .filter-chip.is-active {
    color: #1d2021;
    background: #8ec07c;
    border-color: #8ec07c;
    font-weight: 700;
  }
</style>

<script>
  const searchInput = document.getElementById('library-search') as HTMLInputElement | null;
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const sections = document.querySelectorAll<HTMLElement>('[data-section]');
  const noResults = document.getElementById('no-results');
  let activeFilter = 'all';
  let query = '';

  function apply() {
    let anyVisible = false;
    sections.forEach((section) => {
      if (section.id === 'passed') {
        const show = activeFilter === 'all' && !query;
        section.classList.toggle('is-hidden', !show);
        return;
      }
      const cards = section.querySelectorAll<HTMLElement>('.media-card');
      let visible = 0;
      cards.forEach((card) => {
        const matchesFilter = activeFilter === 'all' || card.dataset.status === activeFilter;
        const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
        const show = matchesFilter && matchesQuery;
        card.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });
      section.classList.toggle('is-hidden', visible === 0);
      if (visible > 0) anyVisible = true;
    });
    noResults?.classList.toggle('hidden', anyVisible);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      activeFilter = chip.dataset.filter ?? 'all';
      apply();
    });
  });

  searchInput?.addEventListener('input', () => {
    query = searchInput.value.trim().toLowerCase();
    apply();
  });
</script>
