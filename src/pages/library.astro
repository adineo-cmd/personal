---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageNavigation from '../components/PageNavigation.astro';
import { books } from '../data/content.js';

// Pre-calculate counts for each status
const counts = {
  all: books.length,
  reading: books.filter(b => b.status === 'reading').length,
  finished: books.filter(b => b.status === 'finished').length,
  want: books.filter(b => b.status === 'want').length,
};

// Calculate total estimated pages
const totalPages = books.reduce((sum, book) => sum + (book.pages || 0), 0);

// Reading challenge data
const challengeGoal = 12;
const challengeRead = counts.finished;
const challengeProgress = Math.min(100, Math.round((challengeRead / challengeGoal) * 100));
const remainingBooks = challengeGoal - challengeRead;
const monthsLeft = 8;

// Generate heatmap data (52 weeks)
const weeks = Array.from({ length: 52 }, (_, i) => {
  const activity = Math.random() > 0.6 ? Math.floor(Math.random() * 4) : 0;
  return { index: i, activity };
});

// Status-based accent colors
const statusColors = {
  reading: {
    text: 'text-[#8ec07c]',
    border: 'border-[#8ec07c]',
    bg: 'bg-[#8ec07c]',
  },
  finished: {
    text: 'text-[#b8bb26]',
    border: 'border-[#b8bb26]',
    bg: 'bg-[#b8bb26]',
  },
  want: {
    text: 'text-[#83a598]',
    border: 'border-[#83a598]',
    bg: 'bg-[#83a598]',
  },
};
---

<BaseLayout title="Library | Aditya Yadav" description="My book collection">
  <>
    <PageNavigation currentPage="library" />

    <div class="min-h-screen bg-[#1d2021] text-[#ebdbb2]">
      <div class="max-w-6xl mx-auto px-4 py-12">
        
        <!-- Header -->
        <header class="mb-8">
          <h1 class="text-5xl md:text-6xl font-serif mb-2">
            <span class="text-[#fbf1c7]">Lib</span><span class="text-[#8ec07c] italic">rary</span>
          </h1>
          <p class="text-[#a89984] text-base max-w-2xl">
            Books I'm reading and have read. A curated shelf of ideas — hover any book to open it.
          </p>
        </header>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-px bg-[#3c3836] border border-[#3c3836] mb-8">
          <div class="bg-[#1d2021] p-5">
            <div class="text-3xl font-serif text-[#8ec07c] mb-1">{counts.reading}</div>
            <div class="text-[10px] text-[#928374] tracking-wider uppercase">Reading</div>
          </div>
          <div class="bg-[#1d2021] p-5">
            <div class="text-3xl font-serif text-[#b8bb26] mb-1">{counts.finished}</div>
            <div class="text-[10px] text-[#928374] tracking-wider uppercase">Finished</div>
          </div>
          <div class="bg-[#1d2021] p-5">
            <div class="text-3xl font-serif text-[#83a598] mb-1">{counts.want}</div>
            <div class="text-[10px] text-[#928374] tracking-wider uppercase">Want to Read</div>
          </div>
          <div class="bg-[#1d2021] p-5">
            <div class="text-3xl font-serif text-[#fe8019] mb-1">~{totalPages.toLocaleString()}</div>
            <div class="text-[10px] text-[#928374] tracking-wider uppercase">Pages Est.</div>
          </div>
          <div class="bg-[#1d2021] p-5">
            <div class="text-3xl font-serif text-[#8ec07c] mb-1">2026</div>
            <div class="text-[10px] text-[#928374] tracking-wider uppercase">Active Since</div>
          </div>
        </div>

        <!-- Reading Challenge -->
        <div class="border border-[#3c3836] bg-[#282828] p-6 mb-8">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex-1">
              <div class="text-[10px] text-[#8ec07c] tracking-widest mb-2 uppercase">2026 Reading Challenge</div>
              <h2 class="text-xl font-serif text-[#fbf1c7] mb-3">Reading 12 books this year</h2>
              <div class="relative h-1.5 bg-[#3c3836] rounded-full mb-2 overflow-hidden">
                <div 
                  class="absolute left-0 top-0 h-full bg-gradient-to-r from-[#8ec07c] to-[#fe8019] rounded-full"
                  style={`width: ${challengeProgress}%`}
                ></div>
              </div>
              <p class="text-[11px] text-[#928374]">
                {challengeProgress}% complete • {remainingBooks} more books to go • {monthsLeft} months left in 2026
              </p>
            </div>
            <div class="text-right">
              <div class="text-4xl font-serif text-[#8ec07c] mb-0.5">{challengeRead}/{challengeGoal}</div>
              <div class="text-[10px] text-[#928374]">books read</div>
            </div>
          </div>
        </div>

        <!-- Search Bar -->
        <div class="mb-6">
          <div class="relative">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-[#928374]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input 
              id="search-input"
              type="text" 
              placeholder="Search title, author, genre..."
              class="w-full bg-[#282828] border border-[#3c3836] text-[#ebdbb2] text-sm pl-11 pr-4 py-2.5 rounded focus:outline-none focus:border-[#8ec07c]/50 placeholder-[#928374]"
            />
          </div>
        </div>

        <!-- Filter Tabs -->
        <div class="flex flex-wrap gap-2 mb-10" id="filter-tabs">
          <button type="button" data-filter="all" class="filter-btn px-4 py-2 border text-xs transition-all bg-[#3c3836] text-[#ebdbb2] border-[#3c3836]">
            ⌕ All
          </button>
          <button type="button" data-filter="reading" class="filter-btn px-4 py-2 border text-xs transition-all text-[#928374] border-[#3c3836] hover:text-[#a89984] hover:border-[#504945]">
            ● Reading
          </button>
          <button type="button" data-filter="finished" class="filter-btn px-4 py-2 border text-xs transition-all text-[#928374] border-[#3c3836] hover:text-[#a89984] hover:border-[#504945]">
            ✓ Finished
          </button>
          <button type="button" data-filter="want" class="filter-btn px-4 py-2 border text-xs transition-all text-[#928374] border-[#3c3836] hover:text-[#a89984] hover:border-[#504945]">
            + Want
          </button>
        </div>

        <!-- Book Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-16" id="book-grid">
          {books.map((book, idx) => {
            const colorScheme = statusColors[book.status] || statusColors.want;
            
            return (
              <div 
                key={idx} 
                class="group cursor-pointer book-card"
                data-title={book.title}
                data-author={book.author}
                data-status={book.status}
                data-tags={book.tags ? book.tags.join(' ') : ''}
              >
                {/* Book Cover */}
                <div class="relative mb-2 aspect-[2/3] overflow-hidden rounded-sm">
                  <div 
                    class="w-full h-full flex items-center justify-center p-3 text-center relative transition-transform duration-300 group-hover:scale-105"
                    style={{ backgroundColor: book.coverColor || '#3c3836' }}
                  >
                    <span 
                      class={`font-serif text-xs leading-relaxed relative z-10 line-clamp-3 ${
                        ['#FFFFFF', '#F5F5F5', '#F5EFE6', '#E6E1D3', '#E0C68C'].includes(book.coverColor) 
                          ? 'text-[#3c3836]' 
                          : 'text-[#ebdbb2]'
                      }`}
                    >
                      {book.title}
                    </span>
                    <div class="absolute inset-0 bg-gradient-to-tr from-black/40 via-transparent to-white/10 pointer-events-none"></div>
                    <div class={`absolute left-0 top-0 bottom-0 w-px bg-white/20`}></div>
                  </div>
                </div>
                
                {/* Book Info */}
                <h3 class="text-sm font-serif text-[#fbf1c7] mb-0.5 line-clamp-1">{book.title}</h3>
                <p class="text-xs text-[#a89984] italic mb-1.5 line-clamp-1">{book.author}</p>
                
                {/* Tags */}
                {book.tags && book.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1">
                    {book.tags.slice(0, 2).map((tag, tidx) => (
                      <span 
                        key={tidx} 
                        class="text-[9px] px-1.5 py-0.5 border border-[#3c3836] text-[#928374] hover:border-[#8ec07c]/50 hover:text-[#8ec07c] transition-colors"
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            );
          })}
          
          <!-- Empty State Message -->
          <div id="no-books-message" class="col-span-full text-center py-16 text-[#928374] italic hidden">
            No books found for this filter.
          </div>
        </div>

        <!-- Reading Activity -->
        <div class="mb-12">
          <h2 class="text-2xl font-serif text-[#fbf1c7] mb-1">Reading Activity</h2>
          <p class="text-sm text-[#928374] italic mb-6">Past 12 months · one square = one week</p>
          
          <div class="border-t border-[#3c3836] pt-6">
            <div class="flex gap-1 overflow-x-auto pb-4">
              {weeks.map(week => {
                const colors = [
                  'bg-[#3c3836]',
                  'bg-[#3c3836]',
                  'bg-[#504945]',
                  'bg-[#7c6f64]',
                  'bg-[#8ec07c]',
                ];
                return (
                  <div
                    key={week.index}
                    class={`w-2.5 h-2.5 rounded-sm flex-shrink-0 ${colors[week.activity] || colors[0]} hover:ring-1 hover:ring-[#8ec07c]/50 transition-all`}
                    title={`Week ${week.index + 1}: ${['No activity', 'Light', 'Moderate', 'Active', 'Very Active'][week.activity]}`}
                  ></div>
                );
              })}
            </div>
            
            <div class="flex items-center gap-2 text-xs text-[#928374] mt-2">
              <span>Less</span>
              <div class="flex gap-1">
                <div class="w-2.5 h-2.5 rounded-sm bg-[#3c3836]"></div>
                <div class="w-2.5 h-2.5 rounded-sm bg-[#3c3836]"></div>
                <div class="w-2.5 h-2.5 rounded-sm bg-[#504945]"></div>
                <div class="w-2.5 h-2.5 rounded-sm bg-[#7c6f64]"></div>
                <div class="w-2.5 h-2.5 rounded-sm bg-[#8ec07c]"></div>
              </div>
              <span>More</span>
            </div>
          </div>
        </div>

        <!-- Footer -->
        <footer class="border-t border-[#3c3836] pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-[#928374] font-mono">
          <span>~/library — reading log</span>
          <span>hover any book to open it</span>
        </footer>

      </div>
    </div>
  </>
</BaseLayout>

<script>
  // Elements
  const searchInput = document.getElementById('search-input');
  const bookCards = document.querySelectorAll('.book-card');
  const filterButtons = document.querySelectorAll('.filter-btn');
  const noBooksMsg = document.getElementById('no-books-message');
  
  let currentFilter = 'all';

  // Initialize active state based on URL params
  const urlParams = new URLSearchParams(window.location.search);
  const initialFilter = urlParams.get('filter') || 'all';
  currentFilter = initialFilter;

  // Set initial active button styling
  filterButtons.forEach(btn => {
    const isActive = btn.dataset.filter === currentFilter;
    if (btn.dataset.filter === 'want') {
       btn.className = `filter-btn px-4 py-2 border text-xs transition-all ${isActive ? 'border-[#8ec07c] text-[#8ec07c]' : 'text-[#928374] border-[#3c3836] hover:text-[#a89984] hover:border-[#504945]'}`;
    } else {
       btn.className = `filter-btn px-4 py-2 border text-xs transition-all ${isActive ? 'bg-[#3c3836] text-[#ebdbb2] border-[#3c3836]' : 'text-[#928374] border-[#3c3836] hover:text-[#a89984] hover:border-[#504945]'}`;
    }
  });

  // Core filtering function
  function applyFilters() {
    const query = searchInput.value.toLowerCase();
    let visibleCount = 0;
    
    bookCards.forEach(card => {
      const title = card.dataset.title?.toLowerCase() || '';
      const author = card.dataset.author?.toLowerCase() || '';
      const tags = card.dataset.tags?.toLowerCase() || '';
      const status = card.dataset.status?.toLowerCase() || '';
      
      const matchesSearch = title.includes(query) || author.includes(query) || tags.includes(query);
      const matchesFilter = currentFilter === 'all' || status === currentFilter;
      
      const isVisible = matchesSearch && matchesFilter;
      card.style.display = isVisible ? '' : 'none';
      if (isVisible) visibleCount++;
    });

    // Toggle empty state message
    if (noBooksMsg) {
      noBooksMsg.classList.toggle('hidden', visibleCount > 0);
    }
  }

  // Initial apply on page load
  applyFilters();

  // Filter button clicks
  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      currentFilter = btn.dataset.filter;
      
      // Update active state styling
      filterButtons.forEach(b => {
        const isActive = b.dataset.filter === currentFilter;
        if (b.dataset.filter === 'want') {
           b.className = `filter-btn px-4 py-2 border text-xs transition-all ${isActive ? 'border-[#8ec07c] text-[#8ec07c]' : 'text-[#928374] border-[#3c3836] hover:text-[#a89984] hover:border-[#504945]'}`;
        } else {
           b.className = `filter-btn px-4 py-2 border text-xs transition-all ${isActive ? 'bg-[#3c3836] text-[#ebdbb2] border-[#3c3836]' : 'text-[#928374] border-[#3c3836] hover:text-[#a89984] hover:border-[#504945]'}`;
        }
      });

      // Update URL without reloading
      const newUrl = currentFilter === 'all' ? window.location.pathname : `?filter=${currentFilter}`;
      window.history.pushState({}, '', newUrl);

      applyFilters();
    });
  });

  // Search input listener
  searchInput?.addEventListener('input', applyFilters);
</script>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>